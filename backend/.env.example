PORT=8080
VEXA_ADMIN_KEY=replace-with-a-secret-from-your-secret-manager
VEXA_NODE_TOKEN=replace-with-a-long-random-node-secret

# Public WireGuard node metadata. Keep the node private key OUT of source control.
VEXA_SERVER_ID=in-mumbai-01
VEXA_SERVER_NAME=VEXA India 01
VEXA_SERVER_COUNTRY=IN
VEXA_SERVER_CITY=Mumbai
VEXA_SERVER_HOST=vpn.example.com
VEXA_SERVER_PORT=51820
VEXA_SERVER_PUBLIC_KEY=replace-with-wireguard-server-public-key
VEXA_SERVER_DNS=1.1.1.1
VEXA_CLIENT_NETWORK=10.64.0.0/16
VEXA_SERVER_LATENCY_MS=50

# Node-agent runtime (on the WireGuard VPS, not in GitHub).
# Production: point this at the HTTPS control-plane URL.
VEXA_API_URL=https://api.example.com
VEXA_WG_INTERFACE=wg0
VEXA_NODE_POLL_MS=5000
# Local development only; keep false/unset in production.
VEXA_ALLOW_INSECURE_HTTP=false
