[Unit]
Description=VEXA WireGuard Node Agent
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vexa-node
EnvironmentFile=/etc/vexa/node-agent.env
ExecStart=/usr/bin/node /opt/vexa-node/vexa-node-agent.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
